{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        // `node` resolution ignores `exports` maps, which is all some dependencies ship.
        // Without this their types silently resolve to `any`.
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "baseUrl": "./src",
        "rootDir": "./src",
        "declarationDir": "./dist",
        "jsx": "react-jsx",
        "types": ["node", "jest", "@testing-library/jest-dom"],
        "typeRoots": ["node_modules/@types", "../../node_modules/@types", "src/@types"]
    },
    "include": ["src", "test", "stories"],
    "exclude": ["node_modules"]
}
